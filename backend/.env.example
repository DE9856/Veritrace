# Copy to backend/.env and adjust. Every value here has a default in app/config.py.

# LLM: "ollama" (local, no key needed), "groq" or "gemini". The demo uses groq.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
LLM_TEMPERATURE=0.2

# Gemini (https://aistudio.google.com/apikey). Free tier: requests are paced to stay
# under GEMINI_REQUESTS_PER_MINUTE.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_REQUESTS_PER_MINUTE=10

# Fallback when the primary provider is rate limited. Used only if its key is set.
# The demo uses groq as the primary and gemini as the fallback.
# Groq keys: https://console.groq.com/keys
LLM_FALLBACK=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Embeddings run locally on the CPU
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu

# Chunking and retrieval
CHUNK_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
TOP_K=6
MAX_UPLOAD_MB=25
# Index the bundled sample documents at startup when the store is empty
SEED_SAMPLES=false

# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# Confidence scoring: weights and thresholds live in config.yaml.
# These two are handy to override per machine:
# Resampled answers per question for the consistency check; 0 turns it off.
CONSISTENCY_SAMPLES=3
JUDGE_ENABLED=true
